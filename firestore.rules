rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sathwikkotha511@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public website reads these; only the owner can change them
    match /catalog_items/{id} { allow read: if true; allow write: if isAdmin(); }
    match /flash_offers/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /site/{id}          { allow read: if true; allow write: if isAdmin(); }

    // Visitor tracking: anyone signed in (anonymous too) can write, only owner reads
    match /events/{id}   { allow create: if request.auth != null; allow read: if isAdmin(); }
    match /sessions/{id} { allow create, update: if request.auth != null; allow read: if isAdmin(); }
    match /customers/{id} { allow create, update: if request.auth != null && request.auth.uid == id; allow read: if isAdmin(); }
  }
}
