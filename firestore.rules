rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CHANGE THIS to your own Google email (the one you will sign in with on admin.html)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'YOUR_EMAIL@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }

    match /customers/{id} {
      allow create, update: if signedIn() && request.auth.uid == id;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow delete: if isAdmin();
    }
    match /sessions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }
    match /events/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }
  }
}
